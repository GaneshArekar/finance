# ==========================================
# VERCEL & PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# 1. MongoDB Atlas Connection
# Ensure your MongoDB Atlas Network Access has IP 0.0.0.0/0 allowed so Vercel serverless functions can connect.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/personal_finance?retryWrites=true&w=majority
MONGODB_DB=personal_finance

# 2. Better Auth Configuration
# Generate a secure 32-character secret using: openssl rand -base64 32
BETTER_AUTH_SECRET=your_32_character_random_secret_here

# (Optional on Vercel: Automatically resolved from VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL if omitted)
# Set these to your production domain (e.g. https://your-project.vercel.app)
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=

# 3. AI Financial Advisor API Key
GROQ_API_KEY=your_ai_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
